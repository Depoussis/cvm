{
 "datasets": [
  {
   "name": "kpi_mercado",
   "displayName": "kpi_mercado",
   "queryLines": [
    "SELECT max(CASE WHEN serie_codigo = 432 THEN valor END) AS meta_selic, max(CASE WHEN serie_codigo = 24363 THEN valor END) AS ibc_br, (SELECT cotacao_venda FROM findata_dev.gold.fct_ptax_diario WHERE simbolo = 'USD' ORDER BY data_cotacao DESC LIMIT 1) AS ptax_usd, (SELECT cotacao_venda FROM findata_dev.gold.fct_ptax_diario WHERE simbolo = 'EUR' ORDER BY data_cotacao DESC LIMIT 1) AS ptax_eur FROM findata_dev.gold.vw_serie_ultimo_valor"
   ]
  },
  {
   "name": "selic",
   "displayName": "selic",
   "queryLines": [
    "SELECT CAST(trunc(data_referencia, 'MM') AS DATE) AS data, CAST(max_by(valor, data_referencia) AS DOUBLE) AS valor, CASE serie_codigo WHEN 432 THEN 'Meta Selic (Copom)' ELSE 'Selic efetiva anualizada' END AS serie FROM findata_dev.gold.fct_serie_valor WHERE serie_codigo IN (432, 1178) AND data_referencia <= current_date() GROUP BY 1, 3"
   ]
  },
  {
   "name": "ptax",
   "displayName": "ptax",
   "queryLines": [
    "SELECT data_cotacao AS data, simbolo, CAST(cotacao_venda AS DOUBLE) AS cotacao_venda FROM findata_dev.gold.fct_ptax_diario WHERE simbolo IN ('USD', 'EUR', 'GBP')"
   ]
  },
  {
   "name": "cambio_mensal",
   "displayName": "cambio_mensal",
   "queryLines": [
    "SELECT mes, simbolo, variacao_pct FROM findata_dev.gold.vw_cambio_mensal WHERE mes >= add_months(trunc(current_date(), 'MM'), -12) AND simbolo IN ('USD', 'EUR', 'GBP', 'JPY', 'CHF')"
   ]
  },
  {
   "name": "ibc",
   "displayName": "ibc",
   "queryLines": [
    "SELECT data_referencia AS mes, CAST(valor AS DOUBLE) AS ibc_br FROM findata_dev.gold.fct_serie_valor WHERE serie_codigo = 24363 AND data_referencia >= DATE'2015-01-01'"
   ]
  },
  {
   "name": "kpi_fundos",
   "displayName": "kpi_fundos",
   "queryLines": [
    "SELECT fundos, pl_total_bi, cotistas, captacao_liquida_bi, mes FROM findata_dev.gold.vw_industria_fundos_mensal WHERE mes = (SELECT max(mes) FROM findata_dev.gold.vw_industria_fundos_mensal WHERE mes < trunc(current_date(), 'MM'))"
   ]
  },
  {
   "name": "industria",
   "displayName": "industria",
   "queryLines": [
    "SELECT mes, pl_total_bi, captacao_liquida_bi FROM findata_dev.gold.vw_industria_fundos_mensal WHERE mes < trunc(current_date(), 'MM')"
   ]
  },
  {
   "name": "vs_selic",
   "displayName": "vs_selic",
   "queryLines": [
    "SELECT mes, classificacao, pct_acima_selic, rentab_mediana_pct, selic_mes_pct, fundos FROM findata_dev.gold.vw_fundos_vs_selic WHERE classificacao IN ('Renda Fixa', 'Multimercado', 'Ações', 'Cambial') AND mes < trunc(current_date(), 'MM')"
   ]
  },
  {
   "name": "top_pl",
   "displayName": "top_pl",
   "queryLines": [
    "SELECT posicao, denominacao_social AS fundo, classificacao, administrador, round(vl_patrim_liq / 1e9, 2) AS pl_bi, nr_cotst AS cotistas, dt_comptc AS data FROM findata_dev.gold.vw_fundos_maiores_pl WHERE posicao <= 20"
   ]
  },
  {
   "name": "execucoes",
   "displayName": "execucoes",
   "queryLines": [
    "SELECT dia, pipeline_name AS pipeline, execution_status AS estado, execucoes, lidos, escritos, rejeitados, duracao_media_s FROM findata_dev.gold.vw_execucoes_resumo WHERE dia >= date_sub(current_date(), 14)"
   ]
  },
  {
   "name": "qualidade",
   "displayName": "qualidade",
   "queryLines": [
    "SELECT ultima, table_name AS tabela, rule_name AS regra, severity AS severidade, registos_falhados FROM findata_dev.gold.vw_qualidade_resumo WHERE result = 'FAILED' AND dia >= date_sub(current_date(), 14)"
   ]
  },
  {
   "name": "reconciliacao",
   "displayName": "reconciliacao",
   "queryLines": [
    "SELECT source_system AS fonte, resultado, count(*) AS entidades, sum(registos_fonte) AS registos_fonte, sum(valores_diferentes + so_na_fonte + so_na_plataforma) AS divergencias, max(executed_at) AS quando FROM findata_dev.control.reconciliation_results WHERE executed_at = (SELECT max(executed_at) FROM findata_dev.control.reconciliation_results r2 WHERE r2.source_system = reconciliation_results.source_system AND r2.entity_name = reconciliation_results.entity_name) GROUP BY ALL"
   ]
  },
  {
   "name": "frescura",
   "displayName": "frescura",
   "queryLines": [
    "SELECT source_system AS fonte, entity_name AS entidade, watermark_value AS ultima_data, datediff(current_date(), to_date(watermark_value)) AS dias, last_full_reconciliation AS reconciliado FROM findata_dev.control.ingestion_watermark WHERE watermark_type = 'reference_date'"
   ]
  }
 ],
