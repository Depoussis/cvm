{
  "name": "pl_findata_diario",
  "properties": {
    "description": "Carga diária: BCB e CVM em paralelo (bronze → silver → gold → reapresentações, dentro de cada job) e depois a verificação de frescura. Qualquer falha falha o pipeline e dispara o alerta alr-findata-${env}-adf-pipeline-falhou.",
    "folder": {
      "name": "findata"
    },
    "parameters": {
      "run_mode": {
        "type": "string",
        "defaultValue": "incremental"
      }
    },
    "activities": [
      {
        "name": "BCB",
        "type": "ExecutePipeline",
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_databricks_job",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "job_id": "${job_id_bcb}",
            "run_mode": {
              "value": "@pipeline().parameters.run_mode",
              "type": "Expression"
            },
            "run_id_origem": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "CVM",
        "type": "ExecutePipeline",
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_databricks_job",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "job_id": "${job_id_cvm}",
            "run_mode": {
              "value": "@pipeline().parameters.run_mode",
              "type": "Expression"
            },
            "run_id_origem": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Frescura",
        "description": "Só corre se as duas cargas tiverem sucesso, para o estado final do pipeline refletir qualquer falha.",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "BCB",
            "dependencyConditions": [
              "Succeeded"
            ]
          },
          {
            "activity": "CVM",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_databricks_job",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "job_id": "${job_id_frescura}",
            "run_mode": "incremental",
            "run_id_origem": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            }
          }
        }
      }
    ]
  }
}